<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Infrastructure Change Control</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="shell">
        <header class="app-header">
            <div>
                <a class="brand" asp-controller="InfraPages" asp-action="Dashboard">Infrastructure Change Control</a>
                <p class="tagline">CQRS web MVP for approvals, scheduling, and execution tracking.</p>
            </div>
            <nav class="app-nav">
                <a asp-controller="InfraPages" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="InfraPages" asp-action="Create">New Change</a>
                <a asp-controller="InfraPages" asp-action="Approvals">Approvals</a>
                <a asp-controller="InfraPages" asp-action="Schedule">Schedule</a>
                <a asp-controller="InfraPages" asp-action="Failures">Failures</a>
            </nav>
        </header>

        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="flash flash-success">@statusMessage</div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="flash flash-error">@errorMessage</div>
        }

        <main class="content">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
