@model WebApplication.Models.MutabilityDemoResult

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Mutable vs. Immutable Demo</h1>
    <p class="lead">This sample shows how a mutable class can be changed in place while an immutable record creates a new copy.</p>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <h2>Mutable class</h2>
        <p><strong>Before:</strong> @Model.MutableBefore</p>
        <p><strong>After:</strong> @Model.MutableAfter</p>
    </div>
    <div class="col-md-6">
        <h2>Immutable record</h2>
        <p><strong>Before:</strong> @Model.ImmutableBefore</p>
        <p><strong>After (new copy):</strong> @Model.ImmutableAfter</p>
    </div>
</div>
