@model IReadOnlyList<WebApplication.Application.Queries.FailedChangeVm>
@{
    ViewData["Title"] = "Failed Changes";
}

<section class="hero">
    <h1>Failed Changes</h1>
    <p class="muted">Recent execution failures from the query projection.</p>
</section>

<section class="panel" style="margin-top: 1rem;">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Title</th>
                    <th>System</th>
                    <th>Environment</th>
                    <th>Failure Reason</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5">No failed changes.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><a asp-controller="InfraPages" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td>
                            <td>@item.SystemName</td>
                            <td>@item.Environment</td>
                            <td>@item.FailureReason</td>
                            <td>@item.UpdatedAtUtc.ToString("u")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
