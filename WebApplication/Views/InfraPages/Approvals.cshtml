@model IReadOnlyList<WebApplication.Application.Queries.PendingApprovalVm>
@{
    ViewData["Title"] = "Pending Approvals";
}

<section class="hero">
    <h1>Pending Approvals</h1>
    <p class="muted">Operational approval queue backed by the read model.</p>
</section>

<section class="panel" style="margin-top: 1rem;">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Title</th>
                    <th>System</th>
                    <th>Environment</th>
                    <th>Requested By</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5">No pending approvals.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><a asp-controller="InfraPages" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td>
                            <td>@item.SystemName</td>
                            <td>@item.Environment</td>
                            <td>@item.RequestedBy</td>
                            <td>@item.CreatedAtUtc.ToString("u")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
