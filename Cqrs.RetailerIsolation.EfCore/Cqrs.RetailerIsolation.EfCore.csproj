<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Cqrs.RetailerIsolation.EfCore</PackageId>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>CQRS</Authors>
    <Description>EF Core save interceptor for retailer-scoped data isolation.</Description>
    <PackageTags>cqrs;multi-tenancy;efcore;retailer-isolation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
